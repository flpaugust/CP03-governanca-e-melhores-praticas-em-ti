  <folder name="Motivation" id="id-94b35042cd2b43ebb71dd0f109d0a38d" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Diretoria de Inovação" id="id-8ee4b98006464d0b8a1b749a78ab5426"/>
    <element xsi:type="archimate:Stakeholder" name="Diretoria de RH" id="id-4fe32fb1031f43fc864bafbe5dfaa619"/>
    <element xsi:type="archimate:Stakeholder" name="Colaboradores Eurofarma" id="id-fc8bfdd3492c44c2a6fcdc2b717626d1"/>
    <element xsi:type="archimate:Driver" name="Engajamento Organizacional:  transformar a inovação em parte do comportamento diário dos funcionários, e não apenas em ações pontuais." id="id-f939709daefe4b79814645ac7e273899"/>
    <element xsi:type="archimate:Driver" name="Necessidade de Visibilidade Executiva:  A alta gestão necessita acompanhar, em tempo real, os resultados das ações de inovação. " id="id-0592a7be90b9486f9415015e852bd637"/>
    <element xsi:type="archimate:Driver" name="Retenção de Talentos Inovadores:  Colaboradores que se destacam por trazer ideias inovadoras merecem o devido  reconhecimento que mantenham esses talentos motivados e evoluindo internamente. " id="id-a9a22e886176473ebc990916b5a52325"/>
    <element xsi:type="archimate:Driver" name="Cultura de Melhoria Continua: incluir a inovação como competência central no cotidiano de trabalho , com ciclos constantes de aprendizado e evolução." id="id-8aa7c5f11e8f405dab62046a1fa89d6f"/>
    <element xsi:type="archimate:Goal" name="Engajar 100% dos colaboradores: Garantir que todos os colaboradores participem de pelo menos uma atividade de inovação no período de um semestre. " id="id-2c4d378b0ade461aba201ce8af0ca502"/>
    <element xsi:type="archimate:Goal" name="Disponibilizar indicadores em tempo real:  Construir painéis executivos com dados de engajamento, performance das ideias, curadoria e impacto, atualizados automaticamente a partir da plataforma. " id="id-dec16e0dae9146f6b7f38242eff055c8"/>
    <element xsi:type="archimate:Goal" name="Reduzir o tempo médio de adoção de programas:  Facilitar a adesão a novos ciclos de inovação, trilhas e desafios." id="id-21fc5e09312d470ab63938a79a36910e"/>
    <element xsi:type="archimate:Goal" name="Aumentar retenção de ideias aplicáveis:  Fazer com que pelo menos 50% das ideias submetidas por colaboradores passem por curadoria e possam ser aplicadas em ações reais." id="id-bd9b085aefe448f6ad0bfb03cca45767"/>
    <element xsi:type="archimate:Goal" name=" Consolidar cultura de inovação na empresa:  Fazer com que a inovação seja percebida não como projeto isolado, mas como prática transversal da organização." id="id-405bf93062044e309e3280db2626c88c"/>
    <element xsi:type="archimate:Outcome" name="Aumento de 50% no índice de participação em 6 meses;  Métrica baseada em login, envio de ideias, conclusão de trilhas e uso de funcionalidades da plataforma." id="id-a1dcd6796fb346519cd5d29bd438e77c"/>
    <element xsi:type="archimate:Outcome" name="Painel de BI acessado por 100% dos gestores semanalmente; Indicadores-chave como: ideias enviadas por setor, tempo médio de análise, ideias aprovadas, participação por trilha." id="id-0e00eb49fa9d4d37912f18f805c3d5b7"/>
    <element xsi:type="archimate:Outcome" name="Redução do tempo de resposta da curadoria para &lt; 5 dias úteis; Tempo entre o envio da ideia e o primeiro retorno (análise, classificação ou feedback estruturado)." id="id-ef86e28165f940d5acaa9c501f9888ff"/>
    <element xsi:type="archimate:Outcome" name=" Ranking mensal publicado por unidade; Estabelecimento de sistema de gamificação visível, com pontos, nível e conquistas vinculadas a benefícios internos." id="id-6f081309dd9d4f10a6a4aca88517ca37"/>
    <element xsi:type="archimate:Requirement" name="Plataforma Gamificada e Acessível; Interface compatível com web, mobile e totens físicos. Utiliza mecânicas de jogo (pontos, badges, rankings) para estimular o engajamento e facilitar a navegação por todos os perfis de usuário." id="id-69f5fd308e1b40a988b92d8f8a5440c6"/>
    <element xsi:type="archimate:Requirement" name="Mecanismo de Recompensa Justo e Claro; Sistema de pontuação transparente baseado em critérios objetivos; Deve possibilitar a troca de pontos por recompensas reais." id="id-83e2fe4f4eba42648341fa8f37791998"/>
    <element xsi:type="archimate:Requirement" name="Chatbot com IA e Recomendação;Assistente virtual que interage com os colaboradores com base no comportamento do usuário." id="id-c88c8200f6c141a8bb51cae272eee397"/>
    <element xsi:type="archimate:Requirement" name=" Feedback Imediato com IA Analítica; Módulo de análise de sentimento e recomendação baseado em dados comportamentais para entregar respostas rápidas, reforçar boas práticas e antecipar gargalos de engajamento." id="id-0512a346718c4d43b0b81fdb868dbc5d"/>
    <element xsi:type="archimate:Requirement" name="Sistema de Métricas e BI Integrado; Exportação automatizada de dados para dashboards internos e Power BI. Acompanhamento de KPIs ." id="id-0241e00a7eb0496085d9eaf915dff34d"/>
    <element xsi:type="archimate:Constraint" name="LGPD (Lei Geral de Proteção de Dados); A plataforma deve garantir a proteção dos dados pessoais, incluindo consentimento explícito, controle de acesso, logs de uso, direito de exclusão e segurança na transmissão." id="id-3aea698d56a4464ea42406ae6f2909f6"/>
    <element xsi:type="archimate:Constraint" name="SLA de Resposta da Curadoria: até 5 dias úteis; Prazo máximo para análise de ideias submetidas antes de retorno com parecer, aprovação, solicitação de ajustes ou justificativa de reprovação." id="id-2b3605b74fbf468e8176c01f14938d0d"/>
    <element xsi:type="archimate:Constraint" name="Compatibilidade com Sistemas Corporativos; Integração com SAP, BI, RH e repositórios internos já existentes para evitar retrabalho, duplicação de informações e garantir unicidade dos dados." id="id-54b12445776543b88568744369289e82"/>
    <element xsi:type="archimate:Constraint" name=" Acessibilidade Digital (W3C AA); A plataforma deve ser navegável por pessoas com deficiência (leitores de tela, contraste, acessibilidade por teclado, etc)." id="id-c0d1ac742f294b6c8c28f348d23d484c"/>
  </folder>
